<!DOCTYPE html>
<!-- The template of THIRD-PARTY-LICENSES.html (cargo-about; settings in about.toml). -->
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>twr: third-party licences</title>
    <style>
        @media (prefers-color-scheme: dark) {
            body { background: #222; color: #eee; }
            a { color: skyblue; }
        }
        main { font-family: sans-serif; max-width: 800px; margin: 0 auto; }
        .licenses-list { list-style-type: none; margin: 0; padding: 0; }
        .license-text { max-height: 200px; overflow-y: scroll; white-space: pre-wrap; }
    </style>
</head>

<body>
    <main>
        <h1>Third-party licences</h1>
        <p>twr is licensed under the Apache License 2.0 (LICENSE and NOTICE, next to this
            file). The twr binary also contains the following open source crates, under the
            licences and notices below.</p>

        <h2>Overview</h2>
        <ul>
            {{#each overview}}
            <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
            {{/each}}
        </ul>

        <h2>Licence texts</h2>
        <ul class="licenses-list">
            {{#each licenses}}
            <li>
                <h3 id="{{id}}">{{name}}</h3>
                <p>Used by:</p>
                <ul>
                    {{#each used_by}}
                    <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
                    {{/each}}
                </ul>
                <pre class="license-text">{{text}}</pre>
            </li>
            {{/each}}
        </ul>
    </main>
</body>

</html>
