# Generated by release/homebrew/render.py from the twr repository's release/homebrew/twr.formula.rb.in,
# for the release its signed sha256sums.txt names. Edit the template, not this file.
class Twr < Formula
  desc "Control tower for parallel coding agents"
  homepage "https://twr.tools/"
  license "Apache-2.0"

  livecheck do
    url :stable
    strategy :github_latest
  end

  uses_from_macos "git"

  on_macos do
    on_arm do
      url "https://github.com/ignaval/twr/releases/download/v@VERSION@/twr-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256_AARCH64_APPLE_DARWIN@"
    end
    on_intel do
      url "https://github.com/ignaval/twr/releases/download/v@VERSION@/twr-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA256_X86_64_APPLE_DARWIN@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/ignaval/twr/releases/download/v@VERSION@/twr-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA256_AARCH64_UNKNOWN_LINUX_MUSL@"
    end
    on_intel do
      url "https://github.com/ignaval/twr/releases/download/v@VERSION@/twr-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA256_X86_64_UNKNOWN_LINUX_MUSL@"
    end
  end

  def install
    bin.install "twr"
    prefix.install "THIRD-PARTY-LICENSES.html"
    doc.install "docs"
  end

  def caveats
    <<~EOS
      Update twr with `brew upgrade twr`: `twr update` leaves a Homebrew install alone.
      twr needs at least one agent CLI: claude (Claude Code), codex or grok.
    EOS
  end

  test do
    assert_equal "twr #{version}", shell_output("#{bin}/twr --version").strip
  end
end
