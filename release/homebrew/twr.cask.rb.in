# Generated by release/homebrew/render.py from the twr repository's release/homebrew/twr.cask.rb.in,
# for the release its signed desktop-sha256sums.txt names. Edit the template, not this file.
cask "twr" do
  version "@VERSION@"
  sha256 "@SHA256_DMG@"

  url "https://github.com/ignaval/twr/releases/download/v#{version}/twr-#{version}-arm64.dmg"
  name "twr"
  desc "One conversation for all your coding agents"
  homepage "https://twr.tools/"

  livecheck do
    url :url
    strategy :github_latest
  end

  auto_updates true
  depends_on arch: :arm64
  depends_on macos: :ventura

  app "twr.app"

  uninstall quit: "tools.twr.desktop"

  # Not ~/.twr: the hub's workspaces and history, which the twr CLI shares.
  zap trash: [
    "~/Library/Application Support/twr-desktop",
    "~/Library/Caches/tools.twr.desktop",
    "~/Library/Caches/tools.twr.desktop.ShipIt",
    "~/Library/Caches/twr-desktop-updater",
    "~/Library/HTTPStorages/tools.twr.desktop",
    "~/Library/Logs/twr-desktop",
    "~/Library/Preferences/tools.twr.desktop.plist",
  ]
end
