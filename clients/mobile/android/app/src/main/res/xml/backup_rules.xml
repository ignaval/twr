<?xml version="1.0" encoding="utf-8"?>
<!-- Before Android 12: the same as data_extraction_rules.xml (allowBackup="false" already turns backup off). -->
<full-backup-content>
    <exclude domain="sharedpref" path="twr-private.xml" />
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
