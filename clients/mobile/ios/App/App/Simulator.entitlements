<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- Local Simulator identity only. Device builds use the actual signing team's identity. -->
  <key>application-identifier</key>
  <string>TWRLOCAL01.$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>keychain-access-groups</key>
  <array><string>TWRLOCAL01.$(PRODUCT_BUNDLE_IDENTIFIER)</string></array>
</dict></plist>
