# Generated by node scripts/arch.mjs. The source archive contains the complete,
# version-matched Electron app and Rust engine; it never uses a system Electron ABI.
pkgname=twr-desktop
pkgver=@VERSION@
pkgrel=1
pkgdesc='One conversation for all your coding agents'
arch=('x86_64')
url='https://github.com/ignaval/twr'
license=('Apache-2.0')
depends=('alsa-lib' 'at-spi2-core' 'cairo' 'dbus' 'expat' 'gcc-libs' 'glib2' 'glibc' 'gtk3' 'libcups' 'libdrm' 'libx11' 'libxcb' 'libxcomposite' 'libxdamage' 'libxext' 'libxfixes' 'libxkbcommon' 'libxrandr' 'mesa' 'nspr' 'nss' 'pango' 'git')
optdepends=('openssh: remote boxes' 'speech-dispatcher: Linux read aloud')
options=('!strip' '!debug')
source=("twr-desktop-${pkgver}-linux-x64.tar.gz")
sha256sums=('@SHA256@')

package() {
  install -dm755 "$pkgdir/opt/twr-desktop" "$pkgdir/usr/bin"
  cp -a "$srcdir/twr-desktop/." "$pkgdir/opt/twr-desktop/"
  chown -R root:root "$pkgdir/opt/twr-desktop"
  # Chromium's sandbox is kept enabled. Its helper is installed with standard sandbox permissions.
  chmod 4755 "$pkgdir/opt/twr-desktop/chrome-sandbox"
  install -Dm755 "$srcdir/twr-desktop/packaging/twr-desktop" "$pkgdir/usr/bin/twr-desktop"
  ln -s /opt/twr-desktop/resources/bin/twr-mobile-gateway "$pkgdir/usr/bin/twr-mobile-gateway"
  install -Dm644 "$srcdir/twr-desktop/packaging/tools.twr.desktop.desktop" "$pkgdir/usr/share/applications/tools.twr.desktop.desktop"
  install -Dm644 "$srcdir/twr-desktop/packaging/icon.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/tools.twr.desktop.svg"
  install -Dm644 "$srcdir/twr-desktop/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/twr-desktop/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
