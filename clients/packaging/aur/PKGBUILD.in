# Maintainer: twr contributors <https://github.com/ignaval/twr>
# Generated by node scripts/aur.mjs from clients/packaging/aur/PKGBUILD.in.
# The release archive contains the complete, version-matched Electron app and
# Rust engine built on the Ubuntu 22.04 ABI; it never uses a system Electron.
pkgname=twr-desktop-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='One conversation for all your coding agents (desktop app)'
arch=('x86_64')
url='https://github.com/ignaval/twr'
license=('Apache-2.0')
provides=('twr-desktop')
conflicts=('twr-desktop')
depends=('alsa-lib' 'at-spi2-core' 'cairo' 'dbus' 'expat' 'gcc-libs' 'glib2' 'glibc' 'gtk3' 'libcups' 'libdrm' 'libx11' 'libxcb' 'libxcomposite' 'libxdamage' 'libxext' 'libxfixes' 'libxkbcommon' 'libsecret' 'libxrandr' 'mesa' 'nspr' 'nss' 'pango' 'git')
optdepends=('openssh: remote boxes' 'speech-dispatcher: Linux read aloud' 'gnome-keyring: encrypted saved hubs and offline history' 'kwallet: alternative secret service')
options=('!strip' '!debug')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/ignaval/twr/releases/download/v${pkgver}/twr-desktop-${pkgver}-linux-x64.tar.gz")
sha256sums=('@SHA256@')

package() {
  install -dm755 "$pkgdir/opt/twr-desktop" "$pkgdir/usr/bin"
  cp -a "$srcdir/twr-desktop/." "$pkgdir/opt/twr-desktop/"
  chown -R root:root "$pkgdir/opt/twr-desktop"
  # Chromium's sandbox is kept enabled. Its helper is installed with standard sandbox permissions.
  chmod 4755 "$pkgdir/opt/twr-desktop/chrome-sandbox"
  install -Dm755 "$srcdir/twr-desktop/packaging/twr-desktop" "$pkgdir/usr/bin/twr-desktop"
  ln -s /opt/twr-desktop/resources/bin/twr-mobile-gateway "$pkgdir/usr/bin/twr-mobile-gateway"
  install -Dm644 "$srcdir/twr-desktop/packaging/tools.twr.desktop.desktop" "$pkgdir/usr/share/applications/tools.twr.desktop.desktop"
  install -Dm644 "$srcdir/twr-desktop/packaging/icon.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/tools.twr.desktop.svg"
  install -Dm644 "$srcdir/twr-desktop/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/twr-desktop/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
